{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bootstrap-sha": "f92c3e49001908c53349890ca438dfc56efc4bbb",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "lumorphia-editor",
      "extra-files": [
        { "type": "json", "path": "packages/editor-recipe/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/editor-engine/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/editor-react/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
