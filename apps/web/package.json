{
  "name": "@lumorphia/editor-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. build:packages && pnpm models && vite",
    "build": "pnpm --dir ../.. build:packages && pnpm models && vite build",
    "models": "editor-models fetch --out models",
    "serve": "node server/serve.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumorphia/editor-engine": "workspace:*",
    "@lumorphia/editor-react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
